{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoMoyu",
  "version": "1.0.0",
  "identifier": "com.fineyh.automoyu",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir app dev",
    "beforeBuildCommand": "pnpm --dir app build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AutoMoyu",
        "width": 380,
        "height": 640,
        "minWidth": 340,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "fineyh",
    "copyright": "© 2026 fineyh · MIT License",
    "license": "MIT",
    "shortDescription": "Minecraft 基岩版自动钓鱼",
    "longDescription": "Minecraft 基岩版自动钓鱼工具：竿收回来就再甩，没有钓鱼机也能全自动钓鱼。",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNkNGNTU0QkM0RjJDQzQKUldURUxFKzhWUFZzWG5mVDZKaklBaE1ZVEVxS09jS21uTzkxTlIzemxPSjlheFp0RGtiZ0tWeC8K",
      "endpoints": ["https://github.com/fineyh/AutoMoyu/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
